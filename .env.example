# Postgres. Локально без базы: DATABASE_URL=memory (данные живут до перезапуска)
DATABASE_URL=memory
# Пароль входа
APP_PASSWORD=
# Длинная случайная строка для подписи cookie: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Адрес сайта (https включает Secure-cookie)
PUBLIC_URL=http://localhost:3000
# На сервере: production
NODE_ENV=development
# Push-уведомления (необязательно): node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://habits.keepsimple.com.ua
